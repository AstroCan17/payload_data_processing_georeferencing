// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python Development Container",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.autopep8",
				"ms-python.pylint",
				"ms-python.black-formatter",
				"ms-python.isort",
				"ms-azuretools.vscode-docker",
				"ms-kubernetes-tools.vscode-kubernetes-tools",
				"yzhang.markdown-all-in-one",
				"davidanson.vscode-markdownlint",
				"redhat.vscode-yaml",
				"ms-vscode.makefile-tools",
				"ms-python.debugpy",
				"redhat.vscode-yaml",
				"github.vscode-pull-request-github",
				"ms-vscode.git"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"editor.formatOnSave": true,
				"python.analysis.diagnosticMode": "workspace",
				"python.analysis.typeCheckingMode": "basic",
				"python.languageServer": "Pylance",
				// Makefile ayarları
				"makefile.makeDirectory": "${workspaceFolder}",
				"makefile.makefilePath": "${workspaceFolder}/Makefile",
				"makefile.extensionOutputFolder": "${workspaceFolder}/.vscode",
				// Python Debugger ayarları
				"python.debugging.pytestEnabled": true,
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"python.testing.nosetestsEnabled": false,
				"python.testing.pytestArgs": [
					"tests"
				],
				// YAML ayarları
				"yaml.format.enable": true,
				"yaml.validate": true,
				"yaml.schemas": {
					"kubernetes": "*.yaml"
				},
				"[yaml]": {
					"editor.insertSpaces": true,
					"editor.tabSize": 2,
					"editor.autoIndent": "keep",
					"editor.formatOnSave": true
				},
				// Git ve GitHub ayarları
				"git.autofetch": true,
				"git.enableSmartCommit": true,
				"git.confirmSync": false,
				"git.branchProtection": [
					"main",
					"master"
				],
				"git.enableCommitSigning": false,
				"git.showActionButton": {
					"publish": true,
					"sync": true,
					"commit": true
				},
				"git.inputValidation": "always",
				"git.fetchOnPull": true,
				// GitHub Pull Request ayarları
				"githubPullRequests.createOnPublish": true,
				"githubPullRequests.defaultMergeMethod": "squash",
				"githubPullRequests.pullRequestDescription": "template",
				"githubPullRequests.useReviewMode": true,
				"githubPullRequests.defaultDeletionMethod.head": "delete",
				// Git diff/merge ayarları
				"diffEditor.ignoreTrimWhitespace": false,
				"diffEditor.maxComputationTime": 0,
				"merge-conflict.autoNavigateNextConflict.enabled": true,
				// Source Control ayarları
				"scm.defaultViewMode": "tree",
				"scm.alwaysShowRepositories": true,
				"scm.inputFontSize": 13
			}
		}
	},
	"forwardPorts": [],
	"postCreateCommand": "pip3 install --user -r requirements/requirements.txt",
	"remoteUser": "vscode"
}